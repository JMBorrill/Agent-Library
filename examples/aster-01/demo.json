{
 "demo": "aster-01",
 "title": "Project ASTER \u2014 low-gravity hopping locomotion demonstrator, Phase 1 concept to SRR readiness (synthetic)",
 "steps": [
  {
   "id": "01-framework-selection",
   "skill": "select-frameworks",
   "script": "select_frameworks.py",
   "args": [
    "inputs/profile.json",
    "--markdown"
   ],
   "expect_exit": 0,
   "output": "outputs/01-framework-selection.md",
   "purpose": "choose packs, skills and agents; state exclusions and oversight level"
  },
  {
   "id": "02-process-tailoring",
   "skill": "se-technical-planning",
   "script": "tailor_process.py",
   "args": [
    "inputs/profile.json",
    "--markdown"
   ],
   "expect_exit": 0,
   "output": "outputs/02-process-tailoring.md",
   "purpose": "tailor process rigour, reviews and named authorities"
  },
  {
   "id": "03-conops-check",
   "skill": "se-stakeholder-conops",
   "script": "conops_check.py",
   "args": [
    "inputs/conops.md",
    "--stakeholders",
    "inputs/stakeholders.csv",
    "--needs",
    "inputs/needs.csv",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/03-conops-check.json",
   "purpose": "check ConOps sections, off-nominal scenarios, needs/MOE links and evidence tags"
  },
  {
   "id": "04a-lowg-draft",
   "skill": "space-low-gravity-mobility",
   "script": "lowg_calc.py",
   "args": [
    "batch",
    "inputs/lowg-cases-draft.json",
    "--json"
   ],
   "expect_exit": 1,
   "output": "outputs/04a-lowg-draft.json",
   "purpose": "DRAFT sizing: single 500 m hop at 0.31 m/s exceeds circular-orbit speed (defect expected)"
  },
  {
   "id": "04b-lowg-sizing",
   "skill": "space-low-gravity-mobility",
   "script": "lowg_calc.py",
   "args": [
    "batch",
    "inputs/lowg-cases.json",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/04b-lowg-sizing.json",
   "purpose": "FIXED sizing: body g, escape/orbital speed, hop, impulse and bounce cases behind requirement values"
  },
  {
   "id": "05a-req-lint-draft",
   "skill": "se-requirements",
   "script": "req_lint.py",
   "args": [
    "inputs/requirements-draft.csv",
    "--json"
   ],
   "expect_exit": 1,
   "output": "outputs/05a-req-lint-draft.json",
   "purpose": "DRAFT register: duplicate ID, TBR in an `approved` row, bad ID, unknown parent, invalid method (defects expected)"
  },
  {
   "id": "05b-req-lint",
   "skill": "se-requirements",
   "script": "req_lint.py",
   "args": [
    "inputs/requirements.csv",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/05b-req-lint.json",
   "purpose": "FIXED register: values derived from lowg_calc or marked TBR"
  },
  {
   "id": "06-function-check",
   "skill": "se-logical-decomposition",
   "script": "function_check.py",
   "args": [
    "inputs/functions.csv",
    "--components",
    "inputs/components.csv",
    "--requirements",
    "inputs/requirements.csv",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/06-function-check.json",
   "purpose": "function tree, flow closure, allocation and requirement trace"
  },
  {
   "id": "07-trade-space",
   "skill": "se-architecture-trades",
   "script": "trade_space.py",
   "args": [
    "inputs/trade-space.json",
    "--export-decision",
    "outputs/07-decision-skeleton.json",
    "--criteria",
    "inputs/criteria.json",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/07-trade-space.json",
   "purpose": "enumerate and screen concept combinations; export decision skeleton"
  },
  {
   "id": "08-decision-matrix",
   "skill": "se-decision-analysis",
   "script": "decision_matrix.py",
   "args": [
    "inputs/decision.json",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/08-decision-matrix.json",
   "purpose": "weighted scoring of estimate/analysis scores with sensitivity; decision PENDING"
  },
  {
   "id": "09-icd-check",
   "skill": "se-interface-control",
   "script": "icd_check.py",
   "args": [
    "inputs/icd.csv",
    "--components",
    "inputs/components.csv",
    "--n2"
   ],
   "expect_exit": 0,
   "output": "outputs/09-icd-check.md",
   "purpose": "interface register consistency and N-squared matrix"
  },
  {
   "id": "10-budget",
   "skill": "space-technical-budgets",
   "script": "budget_calc.py",
   "args": [
    "inputs/budget.csv",
    "--policy",
    "inputs/margin-policy.json",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/10-budget.json",
   "purpose": "mass and per-mode power roll-up against a labelled example/proposed margin policy"
  },
  {
   "id": "11-risk-check",
   "skill": "se-risk-analysis",
   "script": "risk_check.py",
   "args": [
    "inputs/risk-register.csv",
    "--policy",
    "inputs/risk-matrix-policy.json",
    "--as-of",
    "2026-10-13",
    "--known-ids",
    "inputs/requirements.csv",
    "inputs/verification-matrix.csv",
    "inputs/icd.csv",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/11-risk-check.json",
   "purpose": "risk register policy conformance; safety escalations"
  },
  {
   "id": "12-fmea",
   "skill": "se-risk-analysis",
   "script": "fmea_calc.py",
   "args": [
    "inputs/fmea.csv",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/12-fmea.json",
   "purpose": "FMEA of spring/flywheel hopper, e-stop and offload rig hazards"
  },
  {
   "id": "13-vmatrix-check",
   "skill": "se-verification-validation",
   "script": "vmatrix_check.py",
   "args": [
    "--requirements",
    "inputs/requirements.csv",
    "inputs/verification-matrix.csv",
    "--include-proposed",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/13-vmatrix-check.json",
   "purpose": "planned verification/validation coverage; all results not_tested"
  },
  {
   "id": "14-integration-check",
   "skill": "se-implementation-integration",
   "script": "integration_check.py",
   "args": [
    "inputs/integration-plan.json",
    "--icd",
    "inputs/icd.csv",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/14-integration-check.json",
   "purpose": "integration sequence logic and interface coverage"
  },
  {
   "id": "15-tpm",
   "skill": "se-technical-assessment",
   "script": "tpm_track.py",
   "args": [
    "inputs/tpm.csv",
    "--milestone",
    "2027-03-15",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/15-tpm.json",
   "purpose": "TPM margins and trend to planned PDR (estimate/analysis values only)"
  },
  {
   "id": "16-srr-readiness",
   "skill": "se-review-gates",
   "script": "review_readiness.py",
   "args": [
    "inputs/review-srr.json",
    "--json"
   ],
   "expect_exit": 1,
   "output": "outputs/16-srr-readiness.json",
   "purpose": "SRR readiness after independent review: 8 open major actions incl. F-01..F-07 -> NO_GO for passing SRR (design work may continue per reviewer)"
  },
  {
   "id": "17-claim-check",
   "skill": "independent-review",
   "script": "claim_check.py",
   "args": [
    "README.md",
    "inputs",
    "--json"
   ],
   "expect_exit": 0,
   "output": "outputs/17-claim-check.json",
   "purpose": "screen README and inputs for overclaimed assurance"
  }
 ]
}