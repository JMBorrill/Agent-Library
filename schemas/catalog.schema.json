{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machine-readable framework catalog extracted from a bundled source",
  "type": "object",
  "required": ["catalog_id", "source_id", "title", "edition", "extraction", "items"],
  "additionalProperties": false,
  "properties": {
    "catalog_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "source_id": {"type": "string"},
    "title": {"type": "string"},
    "edition": {"type": "string"},
    "description": {"type": "string"},
    "extraction": {
      "type": "object",
      "required": ["method", "date", "fidelity"],
      "additionalProperties": true,
      "properties": {
        "method": {"type": "string"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "fidelity": {"enum": ["verbatim", "verbatim-normalised-whitespace", "paraphrased", "structural"]},
        "notes": {"type": "string"},
        "pages_reviewed": {"type": "string"}
      }
    },
    "levels": {"type": "object"},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "parameters": {"type": "object"}
  },
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["pdf_page"],
      "additionalProperties": false,
      "properties": {
        "pdf_page": {"type": "integer", "minimum": 1},
        "printed_page": {"type": ["string", "integer"]},
        "section": {"type": "string"}
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "parent": {"type": ["string", "null"]},
        "citation": {"$ref": "#/$defs/citation"}
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "text", "citation"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "text": {"type": "string", "minLength": 3},
        "group": {"type": "string"},
        "citation": {"$ref": "#/$defs/citation"}
      }
    }
  }
}
