{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-library/finance-npv-irr/cashflow-output.schema.json",
  "title": "cashflow.py --json output",
  "type": "object",
  "required": ["assumptions", "results", "findings", "summary", "passed", "scope"],
  "properties": {
    "name": {"type": "string"},
    "passed": {"type": "boolean"},
    "scope": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "object",
      "required": ["convention", "convention_meaning"],
      "properties": {"convention": {"enum": ["t0", "t1"]}}
    },
    "results": {
      "type": "object",
      "properties": {
        "npv": {"type": "number"},
        "irr": {
          "type": "object",
          "required": ["irr", "roots", "sign_changes", "status"],
          "properties": {
            "irr": {"type": ["number", "null"]},
            "roots": {"type": "array", "items": {"type": "number"}},
            "status": {"enum": ["unique", "none-no-sign-change", "multiple-possible", "not-found-in-range"]}
          }
        },
        "mirr": {"type": ["number", "null"]},
        "profitability_index": {"type": ["number", "null"]},
        "payback_simple": {"$ref": "#/$defs/payback"},
        "payback_discounted": {"$ref": "#/$defs/payback"},
        "dcf": {"type": ["object", "null"]}
      }
    },
    "summary": {"type": "object", "required": ["errors", "warnings", "info"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "rule", "message"],
        "properties": {
          "severity": {"enum": ["error", "warning", "info"]},
          "rule": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
        }
      }
    }
  },
  "$defs": {
    "payback": {
      "type": "object",
      "required": ["period", "never", "reverses"],
      "properties": {"period": {"type": ["number", "null"]}, "never": {"type": "boolean"}, "reverses": {"type": "boolean"}}
    }
  }
}
