{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-library/ai-prompt-injection-review/tool-calls.schema.json",
  "title": "Proposed agent tool calls",
  "type": "object",
  "required": ["calls"],
  "properties": {
    "calls": {"type": "array", "items": {
      "type": "object", "required": ["call_id", "tool", "args", "provenance", "data_classification"],
      "properties": {
        "call_id": {"type": "string"},
        "tool": {"type": "string"},
        "args": {"type": "object"},
        "provenance": {"type": "string", "description": "user|system|retrieved_content|tool_output; anything else is denied"},
        "data_classification": {"type": "string", "description": "public|internal|confidential|personal|special_category"},
        "expected_decision": {"enum": ["allow", "deny", "require_approval"]},
        "note": {"type": "string"}}}}
  }
}
