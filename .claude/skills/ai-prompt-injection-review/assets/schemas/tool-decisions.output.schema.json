{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-library/ai-prompt-injection-review/tool-decisions.output.schema.json",
  "title": "tool_policy_check.py --json output",
  "type": "object",
  "required": ["decisions", "summary", "findings", "passed", "policy"],
  "properties": {
    "passed": {"type": "boolean"},
    "decisions": {"type": "array", "items": {
      "type": "object", "required": ["call_id", "tool", "decision", "reasons"],
      "properties": {
        "decision": {"enum": ["allow", "deny", "require_approval"]},
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["decision", "rule", "message"],
                    "properties": {"rule": {"type": "string", "pattern": "^TP-[A-Z-]+$"}}}}}}},
    "summary": {"type": "object", "required": ["calls", "allow", "deny", "require_approval"]},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "severity", "rule", "message"],
                 "properties": {"rule": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}}}},
    "policy": {"type": "object"}
  }
}
