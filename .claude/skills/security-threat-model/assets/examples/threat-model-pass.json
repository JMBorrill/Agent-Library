   "id": "T01",
   "title": "Credential stuffing against tenant user login",
   "stride": "S",
   "targets": [
    "DF1"
   ],
   "likelihood": "high",
   "impact": "high",
   "status": "open",
   "mitigations": [
    {
     "description": "Rate limiting and MFA for tenant admins",
     "asvs": [
      "v5.0.0-6.3.1",
      "v5.0.0-2.4.1"
     ],
     "status": "implemented"
    }
   ]
  },
  {
   "id": "T02",
   "title": "Request tampering of booking parameters in transit",
   "stride": "T",
   "targets": [
    "DF1"
   ],
   "likelihood": "low",
   "impact": "medium",
   "status": "open",
   "mitigations": [
    {
     "description": "HTTPS only with HSTS",
     "asvs": [
      "v5.0.0-12.2.1",
      "v5.0.0-3.4.1"
     ],
     "status": "implemented"
    }
   ]
  },
  {
   "id": "T03",
   "title": "Session token disclosure via insecure cookie",
   "stride": "I",
   "targets": [
    "DF1"
   ],
   "likelihood": "medium",
   "impact": "high",
   "status": "open",
   "mitigations": [
    {
     "description": "Secure, HttpOnly, SameSite cookies",
     "asvs": [
      "v5.0.0-3.3.1"
     ],
     "status": "implemented"
    }
   ]
  },
  {
   "id": "T04",
   "title": "Booking API flooding exhausts capacity for all tenants",
   "stride": "D",
   "targets": [
    "DF1"
   ],
   "likelihood": "medium",
   "impact": "medium",
   "status": "open",
   "mitigations": [
    {
     "description": "Per-tenant rate limits and quotas",
     "asvs": [
      "v5.0.0-2.4.1"
     ],
     "status": "implemented"
    }
   ]
  },
  {
   "id": "T05",
   "title": "User changes tenant_id in request to act in another tenant",
   "stride": "E",
   "targets": [
    "DF1",
    "C2"
   ],
   "likelihood": "medium",
   "impact": "high",
   "status": "open",
   "mitigations": [
    {
     "description": "Tenant derived from session, never from request; object-level authorization",
     "asvs": [
      "v5.0.0-8.2.2",
      "v5.0.0-8.3.1"
     ],
     "status": "verified"
    }
   ],
   "tenant_isolation": true
  },
  {
   "id": "T06",
   "title": "SQL injection through CRM search modifies tenant data",
   "stride": "T",
   "targets": [
    "DF2"
   ],
   "likelihood": "medium",
   "impact": "high",
   "status": "open",
   "mitigations": [
    {
     "description": "Parameterised queries via ORM; no string-built SQL",
     "asvs": [
      "v5.0.0-1.2.4"
     ],
     "status": "implemented"
    }
   ]
  },
  {
   "id": "T07",
   "title": "Query missing tenant filter returns another tenant's contacts",
   "stride": "I",
   "targets": [
    "DF2"
   ],
   "likelihood": "medium",
   "impact": "high",
   "status": "open",
   "mitigations": [
    {
     "description": "Row-level security policy keyed on tenant_id plus repository-layer filter and tests",
     "asvs": [
      "v5.0.0-8.2.2",
      "v5.0.0-8.4.1"
     ],
     "status": "verified"
    }
   ],
   "tenant_isolation": true
  },
  {
   "id": "T08",
   "title": "Unbounded report query exhausts shared database",
   "stride": "D",
   "targets": [
    "DF2"
   ],
   "likelihood": "medium",
   "impact": "medium",
   "status": "accepted",
   "mitigations": [],
