  {
   "id": "C1",
   "name": "Tenant user browser",
   "type": "external_entity",
   "trust_zone": "internet"
  },
  {
   "id": "C2",
   "name": "Platform API (CRM + scheduling)",
   "type": "process",
   "trust_zone": "app"
  },
  {
   "id": "C3",
   "name": "Tenant database (shared schema, tenant_id column)",
   "type": "data_store",
   "trust_zone": "data"
  },
  {
   "id": "C4",
   "name": "LLM provider API",
   "type": "external_entity",
   "trust_zone": "third_party"
  },
  {
   "id": "C5",
   "name": "Calendar provider webhooks",
   "type": "external_entity",
   "trust_zone": "internet"
  },
  {
   "id": "C6",
   "name": "Background worker (reminders, AI summaries)",
   "type": "process",
   "trust_zone": "app"
  }
 ],
 "trust_boundaries": [
  {
   "id": "TB1",
   "name": "Internet to platform edge"
  },
  {
   "id": "TB2",
   "name": "Platform to third-party AI provider"
  },
  {
   "id": "TB3",
   "name": "Application tier to data tier"
  }
 ],
 "assets": [
  {
   "id": "A1",
   "name": "Tenant CRM contacts and notes",
   "classification": "confidential"
  },
  {
   "id": "A2",
   "name": "Appointments and calendars",
   "classification": "confidential"
  },
  {
   "id": "A3",
   "name": "Session tokens",
   "classification": "restricted"
  },
  {
   "id": "A4",
   "name": "LLM prompts and completions containing CRM data",
   "classification": "confidential"
  }
 ],
 "data_flows": [
  {
   "id": "DF1",
   "from": "C1",
   "to": "C2",
   "data": [
    "A1",
    "A2",
    "A3"
   ],
   "protocol": "HTTPS",
   "crosses_boundary": true,
   "boundary": "TB1",
   "required_categories": "STIDE"
  },
  {
   "id": "DF2",
   "from": "C2",
   "to": "C3",
   "data": [
    "A1",
    "A2"
   ],
   "protocol": "PostgreSQL over TLS",
   "crosses_boundary": true,
   "boundary": "TB3"
  },
  {
   "id": "DF3",
   "from": "C2",
   "to": "C4",
   "data": [
    "A4"
   ],
   "protocol": "HTTPS",
   "crosses_boundary": true,
   "boundary": "TB2"
  },
  {
   "id": "DF4",
   "from": "C5",
   "to": "C2",
   "data": [
    "A2"
   ],
   "protocol": "HTTPS",
   "crosses_boundary": true,
   "boundary": "TB1",
   "required_categories": "STID",
