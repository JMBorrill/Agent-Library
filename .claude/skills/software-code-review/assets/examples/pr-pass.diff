diff --git a/src/scheduling/slots.py b/src/scheduling/slots.py
index 4444444..5555555 100644
--- a/src/scheduling/slots.py
+++ b/src/scheduling/slots.py
@@ -12,7 +12,12 @@ from datetime import timedelta
 
 def overlaps(a, b):
     """Return True when two booking slots overlap."""
-    return a.start < b.end and b.start < a.end
+    if a.tenant_id != b.tenant_id:
+        # Slots from different tenants never conflict (AIOPS-412).
+        return False
+    return a.start < b.end and b.start < a.end
+
 
 def duration(slot):
     return slot.end - slot.start
