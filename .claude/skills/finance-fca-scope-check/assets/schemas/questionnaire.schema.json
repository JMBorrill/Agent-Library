{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-library/finance-fca-scope-check/questionnaire.schema.json",
  "title": "Product questionnaire for UK regulatory applicability triage",
  "type": "object",
  "required": ["jurisdiction", "customer_types", "products", "service_model", "activities",
               "ai_in_decisions", "vulnerable_customers", "handles_complaints"],
  "properties": {
    "product_name": {"type": "string"},
    "assessment_date": {"type": "string", "format": "date"},
    "jurisdiction": {"type": "string", "minLength": 1},
    "customer_types": {"type": "array", "minItems": 1, "items": {"enum": ["consumer", "business"]}},
    "products": {"type": "array", "minItems": 1, "items": {"enum": ["first_charge_mortgage", "second_charge_mortgage", "buy_to_let_mortgage", "unsecured_consumer_credit", "bnpl", "business_lending", "other"]}},
    "service_model": {"enum": ["advice", "execution_only", "information_criteria_search", "lending_direct"]},
    "activities": {
      "type": "object",
      "required": ["arranges", "advises", "lends"],
      "properties": {"arranges": {"type": "boolean"}, "advises": {"type": "boolean"}, "lends": {"type": "boolean"}}
    },
    "performs_affordability_calculation": {"type": "boolean"},
    "communicates_promotions": {"type": "boolean"},
    "ai_in_decisions": {"type": "boolean"},
    "vulnerable_customers": {"type": "boolean"},
    "handles_complaints": {"type": "boolean"},
    "processes_personal_data": {"type": "boolean"}
  }
}
