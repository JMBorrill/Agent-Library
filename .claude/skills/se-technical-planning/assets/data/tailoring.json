      "name": "Technical Data Management",
      "skill": "se-technical-data-management",
      "artifacts": {
        "light": "shared folder with owners",
        "standard": "data register",
        "rigorous": "data register + access control + retention"
      }
    },
    {
      "id": "SE-16",
      "name": "Technical Assessment",
      "skill": "se-technical-assessment",
      "artifacts": {
        "light": "informal status",
        "standard": "TPMs + reviews",
        "rigorous": "TPMs + independent reviews at each milestone"
