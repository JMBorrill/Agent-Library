{
  "_provenance": "Library-defined tailoring heuristics (original). Process names follow the NASA SE Handbook's 17 common technical processes as corroborated by secondary sources; levels and artifacts are this library's proposal, not NASA policy.",
  "levels": [
    "light",
    "standard",
    "rigorous"
  ],
  "processes": [
    {
      "id": "SE-01",
      "name": "Stakeholder Expectations Definition",
      "skill": "se-stakeholder-conops",
      "artifacts": {
        "light": "one-page mission brief",
        "standard": "conops.md + stakeholders.csv + needs.csv",
        "rigorous": "conops + validated MOEs + stakeholder sign-off"
      }
    },
    {
      "id": "SE-02",
      "name": "Technical Requirements Definition",
      "skill": "se-requirements",
      "artifacts": {
        "light": "5-20 requirements in requirements.csv",
        "standard": "full register linted, traced to needs",
        "rigorous": "register linted --strict, independent review, baseline approval"
      }
    },
    {
      "id": "SE-03",
      "name": "Logical Decomposition",
      "skill": "se-logical-decomposition",
      "artifacts": {
        "light": "function list",
        "standard": "function tree with allocation",
        "rigorous": "function tree + flows closed + derived requirements"
      }
    },
    {
      "id": "SE-04",
      "name": "Design Solution Definition",
      "skill": "se-architecture-trades",
      "artifacts": {
        "light": "sketch + rationale",
        "standard": "trade space + decision record",
        "rigorous": "trade space + sensitivity + compliance matrix"
      }
    },
    {
      "id": "SE-05",
      "name": "Product Implementation",
      "skill": "se-implementation-integration",
      "artifacts": {
        "light": "build notes",
        "standard": "make/buy/reuse with unit acceptance",
        "rigorous": "build records + receiving inspection + unit verification evidence"
      }
    },
    {
      "id": "SE-06",
      "name": "Product Integration",
      "skill": "se-implementation-integration",
      "artifacts": {
        "light": "integration checklist",
        "standard": "integration plan checked",
        "rigorous": "integration plan + step records + anomaly log"
      }
    },
    {
      "id": "SE-07",
      "name": "Product Verification",
      "skill": "se-verification-validation",
      "artifacts": {
        "light": "minimum test matrix",
        "standard": "verification matrix with evidence",
        "rigorous": "matrix + procedures + independent witness for critical items"
      }
    },
    {
      "id": "SE-08",
      "name": "Product Validation",
      "skill": "se-verification-validation",
      "artifacts": {
        "light": "owner demo",
        "standard": "validation plan against MOEs",
        "rigorous": "operational validation with users + records"
      }
    },
    {
      "id": "SE-09",
      "name": "Product Transition",
      "skill": "se-transition",
      "artifacts": {
        "light": "handover note",
        "standard": "transition checklist",
        "rigorous": "transition package + acceptance record + support plan"
      }
    },
    {
      "id": "SE-10",
      "name": "Technical Planning",
      "skill": "se-technical-planning",
      "artifacts": {
