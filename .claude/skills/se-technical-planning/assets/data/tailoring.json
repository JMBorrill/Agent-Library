        "rigorous": "SEMP-style plan + authorities + reserves"
      }
    },
    {
      "id": "SE-11",
      "name": "Requirements Management",
      "skill": "se-requirements",
      "artifacts": {
        "light": "edit with history",
        "standard": "baseline + change control",
        "rigorous": "baselines + CR board + trace audits"
      }
    },
    {
      "id": "SE-12",
      "name": "Interface Management",
      "skill": "se-interface-control",
      "artifacts": {
        "light": "interface notes",
        "standard": "ICD register checked",
        "rigorous": "ICDs baselined, both owners sign"
      }
    },
    {
      "id": "SE-13",
      "name": "Technical Risk Management",
      "skill": "se-risk-analysis",
