{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-library/sre-incident-response/postmortem.schema.json",
  "title": "Blameless postmortem (JSON form accepted by postmortem_check.py)",
  "type": "object",
  "required": ["severity", "summary", "impact", "timeline", "root_causes", "contributing_factors", "detection",
               "response", "went_well", "went_badly", "action_items"],
  "properties": {
    "severity": {"type": "string", "pattern": "^(SEV-?[1-4]|S[1-4]|P[0-4])$"},
    "summary": {"type": "string", "minLength": 1},
    "impact": {"type": "string", "pattern": "\\d"},
    "timeline": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["time", "event"]}},
    "root_causes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "contributing_factors": {"type": "array", "items": {"type": "string"}},
    "detection": {"type": "string"},
    "response": {"type": "string"},
    "went_well": {"type": "array", "items": {"type": "string"}},
    "went_badly": {"type": "array", "items": {"type": "string"}},
    "action_items": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["description", "owner", "priority", "due", "tracking_id"],
      "properties": {"priority": {"type": "string", "pattern": "^(P[0-4]|critical|high|medium|low)$"},
                     "due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                     "tracking_id": {"type": "string", "pattern": "^([A-Z][A-Z0-9]+-\\d+|#\\d+)$"}}}}
  }
}
