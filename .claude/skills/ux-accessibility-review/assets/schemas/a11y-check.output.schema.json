{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-library/ux-accessibility-review/a11y-check.output.schema.json",
  "title": "html_a11y_check.py --json output",
  "type": "object",
  "required": ["findings", "summary", "passed"],
  "properties": {
    "passed": {"type": "boolean"},
    "summary": {
      "type": "object",
      "required": ["errors", "warnings", "source_rules", "manual_checks_required"],
      "properties": {
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "source_rules": {"type": "array", "items": {"type": "string"}},
        "manual_checks_required": {"const": true}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "rule", "message", "source_rule", "wcag"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["error", "warning", "info"]},
          "rule": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "message": {"type": "string", "minLength": 1},
          "source_rule": {"type": "string", "pattern": "^(GDS|LOCAL)-[A-Z]+-[0-9]{2}$"},
          "related_rule": {"type": "string", "pattern": "^GDS-[A-Z]+-[0-9]{2}$"},
          "wcag": {"type": ["string", "null"]}
        }
      }
    }
  }
}
