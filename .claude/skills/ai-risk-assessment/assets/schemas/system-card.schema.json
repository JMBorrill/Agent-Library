{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-library/ai-risk-assessment/system-card.schema.json",
  "title": "Model / AI system card (synthetic library format)",
  "type": "object",
  "required": ["card_version", "system_name", "system_version", "card_date", "intended_use",
               "out_of_scope_uses", "data_lineage", "evaluations", "known_limitations",
               "human_oversight", "monitoring", "rollback_plan", "contacts", "sign_off"],
  "properties": {
    "card_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "system_name": {"type": "string", "minLength": 1},
    "system_version": {"type": "string", "minLength": 1},
    "card_date": {"type": "string", "format": "date"},
    "model_details": {
      "type": "object",
      "properties": {
        "base_model": {"type": "string"},
        "provider": {"type": "string"},
        "model_version": {"type": "string"},
        "architecture": {"type": "string"}
      }
    },
    "intended_use": {
      "type": "object",
      "required": ["description", "users", "decision_context"],
      "properties": {
        "description": {"type": "string", "minLength": 20},
        "users": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "decision_context": {"type": "string", "minLength": 1}
      }
    },
    "out_of_scope_uses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "data_lineage": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "source", "contains_personal_data"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "licence": {"type": "string"},
          "contains_personal_data": {"type": "boolean"},
          "lawful_basis_ref": {"type": "string"}
        }
      }
    },
    "evaluations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["eval_id", "metric", "value", "threshold", "comparator", "date", "dataset",
                     "dataset_version", "result"],
        "properties": {
          "eval_id": {"type": "string", "minLength": 1},
          "metric": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "threshold": {"type": "number"},
          "comparator": {"enum": [">=", "<=", "==", ">", "<"]},
          "n": {"type": "integer", "minimum": 0},
          "date": {"type": "string", "format": "date"},
          "dataset": {"type": "string", "minLength": 1},
          "dataset_version": {"type": "string", "minLength": 1},
          "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result": {"enum": ["pass", "fail", "not_tested"]}
        }
      }
    },
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "trustworthiness_notes": {"type": "object"},
    "human_oversight": {
      "type": "object",
      "required": ["summary", "approver_role"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "approver_role": {"type": "string", "minLength": 1},
        "oversight_matrix_ref": {"type": "string"}
      }
    },
    "monitoring": {
      "type": "object",
      "required": ["metrics", "review_frequency", "alert_owner"],
      "properties": {
        "metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "review_frequency": {"type": "string", "minLength": 1},
        "alert_owner": {"type": "string", "minLength": 1}
      }
    },
    "rollback_plan": {
      "type": "object",
      "required": ["triggers", "procedure", "owner"],
      "properties": {
        "triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "procedure": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "last_tested": {"type": "string", "format": "date"}
      }
    },
    "contacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "name"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "email": {"type": "string"}
        }
      }
    },
    "risk_register_ref": {"type": "string"},
    "recommendation": {"enum": ["GO", "GO_WITH_CONDITIONS", "NO_GO"]},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "sign_off": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "signed", "rejected"]},
        "name": {"type": "string"},
        "role": {"type": "string"},
        "date": {"type": "string", "format": "date"}
      }
    }
  }
}
