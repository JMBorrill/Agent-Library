{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-library/product-requirements-brief/prd-check.output.schema.json",
  "title": "prd_check.py --json output",
  "type": "object",
  "required": ["findings", "summary", "passed"],
  "properties": {
    "passed": {"type": "boolean"},
    "summary": {
      "type": "object",
      "required": ["stories", "flowed_down_rows", "errors", "warnings"],
      "properties": {
        "stories": {"type": "integer", "minimum": 0},
        "flowed_down_rows": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "rule", "message"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["error", "warning", "info"]},
          "rule": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
